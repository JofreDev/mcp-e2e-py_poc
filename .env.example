# Optional. If omitted, auth-service generates a random secret on its first start and
# persists it in the Docker volume. Set this explicitly when you need to control it.
# AUTH_JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes

# These ports are only bound to localhost by Docker Compose.
AUTH_SERVICE_PORT=8000
MCP_SERVICE_PORT=8001
