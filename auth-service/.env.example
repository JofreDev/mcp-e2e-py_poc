# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=replace-with-generated-secret
AUTH_DATABASE_URL=sqlite+aiosqlite:///./auth.db
AUTH_AUTO_CREATE_SCHEMA=false
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=mcp-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# Optional. Uncomment both values to bootstrap an administrator.
# AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-this-password
